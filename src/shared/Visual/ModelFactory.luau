--!strict
-- Builds the 3D models of buildables and weapons, used by server and client. Priority:
--   1. your own model:   ReplicatedStorage.Assets.Buildables.<buildableId> / Assets.Weapons.<fullSet>
--   2. the mesh library: ReplicatedStorage.Assets.BlackMarketMeshes (assets/BlackMarketMeshes.fbx
--      imported once in Studio, described by Config/MeshLibrary, generated by tools/meshgen)
--   3. placeholder parts from the configs (always works)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = script.Parent.Parent:WaitForChild("Config")
local Visual = require(Config:WaitForChild("Visual"))
local Economy = require(Config:WaitForChild("Economy"))
local MeshLibrary = require(Config:WaitForChild("MeshLibrary"))
local AxisFit = require(script.Parent.Parent:WaitForChild("Logic"):WaitForChild("AxisFit"))

local ModelFactory = {}

local function vec(v: { x: number, y: number, z: number }): Vector3
	return Vector3.new(v.x, v.y, v.z)
end

local function material(name: string?): Enum.Material
	if name then
		local ok, m = pcall(function()
			return (Enum.Material :: any)[name]
		end)
		if ok and m then
			return m
		end
	end
	return Enum.Material.SmoothPlastic
end

local function shape(name: string?): Enum.PartType
	if name == "Ball" then
		return Enum.PartType.Ball
	elseif name == "Cylinder" then
		return Enum.PartType.Cylinder
	end
	return Enum.PartType.Block
end

-- Mesh library ------------------------------------------------------------------------------------

type MeshTemplate = { part: MeshPart, cf: CFrame, size: Vector3, mat: string }

local library: { [string]: { MeshTemplate } }? = nil
local libraryLoaded = false

-- Size of the world-aligned box around a part of local size `size` turned by rotation `r`.
local function worldBox(r: CFrame, size: Vector3): Vector3
	local x, y, z = r.RightVector, r.UpVector, -r.LookVector
	return Vector3.new(
		math.abs(x.X) * size.X + math.abs(y.X) * size.Y + math.abs(z.X) * size.Z,
		math.abs(x.Y) * size.X + math.abs(y.Y) * size.Y + math.abs(z.Y) * size.Z,
		math.abs(x.Z) * size.X + math.abs(y.Z) * size.Y + math.abs(z.Z) * size.Z
	)
end

-- Among the 24 axis-aligned rotations, those that turn `size` into `expected`; returns the one
-- closest to `hint` (nil when none fits: the mesh was rescaled unevenly).
local function closestAxisRotation(hint: CFrame, size: Vector3, expected: Vector3, tolerance: number): CFrame?
	local axes = { Vector3.xAxis, -Vector3.xAxis, Vector3.yAxis, -Vector3.yAxis, Vector3.zAxis, -Vector3.zAxis }
	local best: CFrame? = nil
	local bestScore = -math.huge
	for _, right in axes do
		for _, up in axes do
			if math.abs(right:Dot(up)) < 0.5 then
				local r = CFrame.fromMatrix(Vector3.zero, right, up)
				if (worldBox(r, size) - expected).Magnitude <= tolerance then
					local score = r.RightVector:Dot(hint.RightVector) + r.UpVector:Dot(hint.UpVector)
					if score > bestScore then
						best, bestScore = r, score
					end
				end
			end
		end
	end
	return best
end

local function loadLibrary(): { [string]: { MeshTemplate } }?
	if libraryLoaded then
		return library
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local root = assets and assets:FindFirstChild("BlackMarketMeshes")
	if root == nil then
		return nil -- not imported (yet): placeholders are used, we check again next time
	end
	libraryLoaded = true
	local anchor = root:FindFirstChild("__origin__", true)
	if anchor == nil or not anchor:IsA("BasePart") then
		warn("[ModelFactory] BlackMarketMeshes has no __origin__ cube: re-import assets/BlackMarketMeshes.fbx")
		return nil
	end
	local scale = 1 / anchor.Size.X -- the origin cube is 1x1x1 stud in the file

	-- 1. every library mesh: where the importer put it (in the origin cube's frame, rescaled) and where
	-- the generator says it belongs (MeshLibrary.Parts + the model's offset in the file)
	type Entry = { d: MeshPart, assetId: string, mat: string, rel: CFrame, imported: Vector3, expected: Vector3?, box: any, offset: Vector3 }
	local entries: { Entry } = {}
	for _, d in root:GetDescendants() do
		if d:IsA("MeshPart") and d ~= anchor then
			local assetId, mat = string.match(d.Name, "^(.-)__(.+)$")
			local info = assetId and MeshLibrary.Models[assetId]
			if info and mat and MeshLibrary.Materials[mat] then
				local rel = anchor.CFrame:ToObjectSpace(d.CFrame)
				local offset = Vector3.new(info.offset.x, info.offset.y, info.offset.z)
				local box = MeshLibrary.Parts[d.Name]
				table.insert(entries, {
					d = d,
					assetId = assetId :: string,
					mat = mat :: string,
					rel = rel,
					imported = rel.Position * scale,
					expected = if box then Vector3.new(box.c[1], box.c[2], box.c[3]) + offset else nil,
					box = box,
					offset = offset,
				})
			end
		end
	end

	-- 2. the importer may have turned the whole file (a half turn is invisible on a cube): find the
	-- 90-degree rotation that best maps the expected positions onto the imported ones
	local fitPairs = {}
	for _, e in entries do
		local ex = e.expected
		if ex then
			table.insert(fitPairs, {
				measured = { x = e.imported.X, y = e.imported.Y, z = e.imported.Z },
				expected = { x = ex.X, y = ex.Y, z = ex.Z },
			})
		end
	end
	local fit, globalError = AxisFit.Best(fitPairs)
	local global = CFrame.fromMatrix(
		Vector3.zero,
		Vector3.new(fit.right.x, fit.right.y, fit.right.z),
		Vector3.new(fit.up.x, fit.up.y, fit.up.z)
	)
	local undo = global:Inverse()

	-- 3. templates: generator position, imported rotation with the global turn removed
	local found: { [string]: { MeshTemplate } } = {}
	local count, moved, fixed = 0, 0, 0
	for _, e in entries do
		local d = e.d
		local size = d.Size * scale
		local rotation = undo * e.rel.Rotation
		local cf = CFrame.new(e.imported - e.offset) * rotation
		local box = e.box
		if box then
			local center = Vector3.new(box.c[1], box.c[2], box.c[3])
			local expectedSize = Vector3.new(box.s[1], box.s[2], box.s[3])
			local tolerance = 0.05 + expectedSize.Magnitude * 0.02
			if (cf.Position - center).Magnitude > 0.1 then
				moved += 1
			end
			local chosen: CFrame? = nil
			for _, r in { rotation, e.rel.Rotation, d.CFrame.Rotation } do
				if (worldBox(r, size) - expectedSize).Magnitude <= tolerance then
					chosen = r
					break
				end
			end
			if chosen == nil then
				fixed += 1
				chosen = closestAxisRotation(rotation, size, expectedSize, tolerance)
			end
			if chosen then
				cf = CFrame.new(center) * chosen
			else
				cf = CFrame.new(center)
				size = expectedSize
			end
		end
		local list = found[e.assetId] or {}
		found[e.assetId] = list
		table.insert(list, { part = d, cf = cf, size = size, mat = e.mat })
		count += 1
	end
	-- scale / rotation of the import, the global turn found, pieces the importer had misplaced
	local o = anchor.Orientation
	local gx, gy, gz = global:ToOrientation()
	print(("[ModelFactory] mesh library loaded: %d meshes (origin size %.3f, rotation %d,%d,%d; import turned %d,%d,%d, fit %.2f; %d repositioned, %d reshaped)"):format(
		count, anchor.Size.X, o.X, o.Y, o.Z, math.deg(gx), math.deg(gy), math.deg(gz), globalError, moved, fixed))
	if globalError > 1 then
		warn("[ModelFactory] the imported library does not match the generator (mirrored or edited?): re-import assets/BlackMarketMeshes.fbx")
	end
	library = found
	return found
end

-- Clones the library meshes of `assetId` into `parent`, placed relative to `origin`.
-- Returns the created parts (empty when the model is not in the library).
local function placeLibrary(assetId: string, parent: Instance, origin: CFrame, canCollide: boolean): { MeshPart }
	local created: { MeshPart } = {}
	local lib = loadLibrary()
	local templates = lib and lib[assetId]
	if templates == nil then
		return created
	end
	local precise = string.sub(assetId, 1, 4) == "bld_" or string.sub(assetId, 1, 6) == "house_"
	for _, t in templates do
		local look = MeshLibrary.Materials[t.mat]
		local p = t.part:Clone()
		for _, child in p:GetChildren() do
			if child:IsA("SurfaceAppearance") then
				child:Destroy()
			end
		end
		p.Size = t.size
		p.CFrame = origin * t.cf
		p.Anchored = true
		p.Material = material(look.material)
		p.Color = Color3.fromHex(look.color)
		p.Transparency = look.transparency
		p.CanCollide = canCollide and look.material ~= "Neon"
		p.CanTouch = false
		p.CastShadow = look.material ~= "Neon" and look.material ~= "Glass"
		p:SetAttribute("MeshMaterial", t.mat)
		if precise then
			-- Automatic fidelity simplifies meshes with distance and twists thin window frames.
			-- Only settable from Studio (command bar build), ignored at run time.
			pcall(function()
				(p :: any).RenderFidelity = Enum.RenderFidelity.Precise
			end)
		end
		p.Parent = parent
		table.insert(created, p)
	end
	return created
end

local function addLibraryMeshes(assetId: string, parent: Instance, origin: CFrame, canCollide: boolean): boolean
	return #placeLibrary(assetId, parent, origin, canCollide) > 0
end

-- For the map builder: places a library model (buildings, props, trap house details).
function ModelFactory.PlaceLibraryModel(assetId: string, parent: Instance, origin: CFrame, canCollide: boolean): { MeshPart }
	return placeLibrary(assetId, parent, origin, canCollide)
end

function ModelFactory.HasMeshes(assetId: string): boolean
	local lib = loadLibrary()
	return lib ~= nil and lib[assetId] ~= nil
end

local function findAsset(folderName: string, name: string): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild(folderName)
	local model = folder and folder:FindFirstChild(name)
	if model and model:IsA("Model") then
		return model
	end
	return nil
end

local function anchorAll(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
end

-- Invisible box matching the object's footprint; used as PrimaryPart and for click selection.
local function makeRoot(size: Vector3, cf: CFrame): Part
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = size
	root.CFrame = cf
	root.Transparency = 1
	root.CanCollide = false
	root.CanTouch = false
	root.CastShadow = false
	root.Anchored = true
	return root
end

function ModelFactory.MakePart(spec: any, parent: Instance, originCf: CFrame, canCollide: boolean): Part
	local p = Instance.new("Part")
	p.Shape = shape(spec.shape)
	p.Size = vec(spec.size)
	p.CFrame = originCf * CFrame.new(vec(spec.pos))
	p.Color = Color3.fromHex(spec.color)
	p.Material = material(spec.material)
	p.Transparency = spec.transparency or 0
	p.Anchored = true
	p.CanCollide = canCollide
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = spec.material ~= "Neon" and spec.material ~= "Glass"
	p.Parent = parent
	return p
end

-- Model centered on CFrame.identity; move it with model:PivotTo().
function ModelFactory.Buildable(def: any): Model
	local size = vec(def.size)
	local asset = findAsset("Buildables", def.id)
	if asset then
		local model = asset:Clone()
		anchorAll(model)
		if model.PrimaryPart == nil then
			local cf = model:GetBoundingBox()
			local root = makeRoot(size, cf)
			root.Parent = model
			model.PrimaryPart = root
		end
		model:PivotTo(CFrame.identity)
		model.Name = def.id
		return model
	end

	local model = Instance.new("Model")
	model.Name = def.id
	local root = makeRoot(size, CFrame.identity)
	root.Parent = model
	model.PrimaryPart = root

	local solid = def.solid ~= false
	if not addLibraryMeshes(def.id, model, CFrame.identity, solid) then
		for _, spec in def.parts do
			ModelFactory.MakePart(spec, model, CFrame.identity, solid)
		end
	end

	if def.light then
		local att = Instance.new("Attachment")
		att.Position = vec(def.light.pos)
		att.Parent = root
		local light = Instance.new("PointLight")
		light.Color = Color3.fromHex(def.light.color)
		light.Range = def.light.range
		light.Brightness = def.light.brightness
		light.Shadows = false
		light.Parent = att
	end
	return model
end

local function partColor(part: any): string
	if part.set and Visual.SetColors[part.set] then
		return Visual.SetColors[part.set]
	end
	return Economy.RarityColor[part.rarity] or "#888888"
end

-- Placeholder weapon (about 4 studs long) from { [slot]: partId }, centered on CFrame.identity.
-- Missing slots are simply skipped, so it also works as a live preview at the workbench.
function ModelFactory.Weapon(partIds: { [string]: string }, catalogue: { [string]: any }, rarity: string?, fullSet: string?): Model
	local asset = if fullSet then findAsset("Weapons", fullSet) else nil
	if asset then
		local model = asset:Clone()
		anchorAll(model)
		model:PivotTo(CFrame.identity)
		return model
	end

	local model = Instance.new("Model")
	model.Name = "Weapon"
	local root = makeRoot(Vector3.new(4, 1.6, 0.5), CFrame.identity)
	root.Parent = model
	model.PrimaryPart = root

	for slot, piece in Visual.WeaponLayout do
		local partId = partIds[slot] or ""
		local part = catalogue[partId]
		if part and not addLibraryMeshes(partId, model, CFrame.identity, false) then
			local p = ModelFactory.MakePart({
				size = piece.size,
				pos = piece.pos,
				shape = piece.shape,
				color = partColor(part),
				material = if part.set == "Neon" then "Neon" else "Metal",
			}, model, CFrame.identity, false)
			p.Name = slot
		end
	end

	if rarity then
		ModelFactory.MakePart({
			size = { x = 1.3, y = 0.08, z = 0.42 },
			pos = { x = 0, y = 0.12, z = 0 },
			color = Economy.RarityColor[rarity] or "#FFFFFF",
			material = "Neon",
		}, model, CFrame.identity, false).Name = "RarityStrip"
	end
	return model
end

return ModelFactory
