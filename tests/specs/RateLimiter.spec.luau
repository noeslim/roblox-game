local RateLimiter = require("../../src/shared/Logic/RateLimiter")

return function(t)
	t.test("allows a burst up to capacity then blocks", function()
		local r = RateLimiter.new(3, 1)
		t.truthy(r:Allow("p", 0))
		t.truthy(r:Allow("p", 0))
		t.truthy(r:Allow("p", 0))
		t.falsy(r:Allow("p", 0))
	end)

	t.test("refills over time, never above capacity", function()
		local r = RateLimiter.new(2, 1)
		r:Allow("p", 0)
		r:Allow("p", 0)
		t.falsy(r:Allow("p", 0.5))
		t.truthy(r:Allow("p", 1.5))
		t.truthy(r:Allow("p", 100))
		t.truthy(r:Allow("p", 100))
		t.falsy(r:Allow("p", 100))
	end)

	t.test("keys are independent and can be forgotten", function()
		local r = RateLimiter.new(1, 0.1)
		t.truthy(r:Allow("a", 0))
		t.truthy(r:Allow("b", 0))
		t.falsy(r:Allow("a", 0))
		r:Forget("a")
		t.truthy(r:Allow("a", 0))
	end)

	t.test("clock going backwards does not add tokens", function()
		local r = RateLimiter.new(1, 1)
		t.truthy(r:Allow("p", 10))
		t.falsy(r:Allow("p", 5))
	end)
end
