local CustomerQueue = require("../../src/shared/Logic/CustomerQueue")

return function(t)
	t.test("join in order, front is first", function()
		local q = CustomerQueue.new(3)
		t.eq(q:Join("a"), 1)
		t.eq(q:Join("b"), 2)
		t.eq(q:Front(), "a")
		t.eq(q:PositionOf("b"), 2)
	end)

	t.test("full queue and duplicates are refused", function()
		local q = CustomerQueue.new(2)
		q:Join("a")
		t.eq(q:Join("a"), nil)
		q:Join("b")
		t.truthy(q:IsFull())
		t.eq(q:Join("c"), nil)
	end)

	t.test("leaving moves everyone up", function()
		local q = CustomerQueue.new(3)
		q:Join("a")
		q:Join("b")
		q:Join("c")
		t.truthy(q:Leave("a"))
		t.eq(q:Front(), "b")
		t.eq(q:PositionOf("c"), 2)
		t.falsy(q:Leave("zzz"))
		t.eq(q:Size(), 2)
	end)
end
